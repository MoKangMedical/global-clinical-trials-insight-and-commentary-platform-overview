# 环境变量配置模板
# 复制此文件为 .env.local 并填入实际值

# 应用配置
APP_NAME=clinical-trials-insight
APP_ENV=development
APP_DEBUG=True
APP_PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///clinical_trials.db

# OpenAI配置（用于AI分析）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# PubMed API配置
PUBMED_API_KEY=your-pubmed-api-key-here
PUBMED_EMAIL=research@clinicaltrials.com

# Unpaywall配置
UNPAYWALL_EMAIL=research@clinicaltrials.com

# AWS S3配置（用于PDF存储）
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=clinical-trials-pdfs

# SendGrid配置（用于邮件通知）
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@clinicaltrials.com

# 应用URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# 安全配置
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# 监控配置
SENTRY_DSN=your-sentry-dsn-here

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/clinical-trials/app.log
